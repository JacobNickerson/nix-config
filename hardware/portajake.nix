    device = "/dev/mapper/luks-8bbc51ac-89c3-4bca-b1a6-df7bf68e2320";
    fsType = "btrfs";
  };

  boot.initrd.luks.devices."luks-8bbc51ac-89c3-4bca-b1a6-df7bf68e2320".device =
    "/dev/disk/by-uuid/8bbc51ac-89c3-4bca-b1a6-df7bf68e2320";

  fileSystems."/boot" = {
    device = "/dev/disk/by-uuid/3645-26AF";
    fsType = "vfat";
    options = [
      "fmask=0022"
      "dmask=0022"
    ];
  };

  fileSystems."/swap" = {
    device = "/dev/mapper/luks-8bbc51ac-89c3-4bca-b1a6-df7bf68e2320";
    fsType = "btrfs";
    options = [ "subvol=swap" ];
  };

  fileSystems."/home" = {
    device = "/dev/mapper/luks-8bbc51ac-89c3-4bca-b1a6-df7bf68e2320";
    fsType = "btrfs";
    options = [ "subvol=home" ];
  };

  swapDevices = [ ];

  nixpkgs.hostPlatform = lib.mkDefault "x86_64-linux";
  hardware.cpu.intel.updateMicrocode = lib.mkDefault config.hardware.enableRedistributableFirmware;
